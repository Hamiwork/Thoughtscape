# Optional integration, disabled by default. No key is needed for preset maps.
THOUGHTSCAPE_ENABLE_AI=false
# Local-only by default. No API Key is needed for Ollama.
THOUGHTSCAPE_API_KEY=
THOUGHTSCAPE_BASE_URL=http://127.0.0.1:11434/v1
THOUGHTSCAPE_MODEL=
# Paid cloud API calls are blocked unless explicitly enabled later.
THOUGHTSCAPE_ALLOW_PAID_API=false
